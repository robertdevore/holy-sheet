{
  "name": "holysheet",
  "version": "0.2.0",
  "description": "Privacy-first portable CSV editor",
  "main": "dist-electron/main.js",
  "author": "Your Name",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.electron.json && vite build && electron-builder && npm run sync:app",
    "preview": "vite preview",
    "electron:dev": "tsc -p tsconfig.electron.json && concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "tsc -p tsconfig.electron.json && vite build",
    "package": "npm run electron:build && electron-builder && npm run sync:app",
    "sync:app": "rm -rf release/HolySheet.app && cp -R release/mac/HolySheet.app release/HolySheet.app",
    "open:release": "open release/HolySheet.app",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "holysheet": "tsx cli/holysheet-cli.ts",
    "holysheet:csv": "tsx cli/holysheet-cli.ts csv",
    "holysheet:strata": "tsx cli/holysheet-cli.ts strata"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-window": "^1.8.10",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^20.10.6",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/ui": "^3.2.4",
    "commander": "^14.0.3",
    "concurrently": "^8.2.2",
    "electron": "^41.10.6",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "jsdom": "^27.0.1",
    "prettier": "^3.8.3",
    "tsx": "^4.22.3",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.60.0",
    "vite": "^5.0.8",
    "vitest": "^3.2.4",
    "wait-on": "^7.2.0"
  },
  "overrides": {
    "esbuild": "0.25.0",
    "tar": "7.5.8"
  },
  "build": {
    "appId": "com.holysheet.app",
    "productName": "HolySheet",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "mac": {
      "target": [
        "dir",
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns"
    },
    "win": {
      "target": "portable",
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": "dir",
      "icon": "build/icon.png"
    }
  }
}
